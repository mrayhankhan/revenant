# ---------------------------------------------------------------------------
# Bright Data — required for live collection.
# Get these from https://brightdata.com (hackathon credit code: wemakedevs)
# ---------------------------------------------------------------------------
BRIGHTDATA_API_KEY=

# Scraper Studio collector ids, one per source. Populated by `npm run collectors:sync`.
BRIGHTDATA_COLLECTOR_GREENHOUSE=
BRIGHTDATA_COLLECTOR_LEVER=
BRIGHTDATA_COLLECTOR_ASHBY=
BRIGHTDATA_COLLECTOR_CAREERS=
BRIGHTDATA_COLLECTOR_CHAOS=

# ---------------------------------------------------------------------------
# Anthropic — used for requirement parsing and CV tailoring.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Local
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/revenant.db

# When true, collectors read from tests/fixtures instead of hitting the network.
# Lets the whole pipeline run with no credentials at all.
REVENANT_OFFLINE=false
