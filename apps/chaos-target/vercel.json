{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/chaos/flip", "destination": "/api/flip" },
    { "source": "/chaos/state", "destination": "/api/state" },
    { "source": "/chaos/truth", "destination": "/api/truth" },
    { "source": "/", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "cache-control", "value": "no-store, max-age=0, must-revalidate" }]
    }
  ]
}
